            new("subjuntivo-preterito-perfecto", "pretérito perfecto", "present perfect", true,
                "a past or completed action in a clause that needs the subjunctive, when the main verb is in the present.",
                "present subjunctive of <em lang=\"es\">haber</em> + past participle.",
                Yo, null,
                [("Me alegro de que hayas venido.", "I'm glad you've come."),
                 ("No creo que lo haya hecho.", "I don't think he has done it.")]),
            new("subjuntivo-imperfecto", "pretérito imperfecto (-ra)", "imperfect", false,
                "the subjunctive after a main verb in the past or the conditional, and in the \"if\" part of hypothetical sentences (<em lang=\"es\">si tuviera…</em>). <em lang=\"es\">Quisiera</em> is also a polite \"I would like\".",
                "the <em lang=\"es\">ellos</em> form of the preterite without <em lang=\"es\">-ron</em> (<em lang=\"es\">tuvieron → tuvie-</em>) + <em lang=\"es\">-ra, -ras, -ra, -ramos, -rais, -ran</em>, so every irregular preterite carries over.",
                Yo, Rows(["ara", "aras", "ara", "áramos", "arais", "aran"], ["iera", "ieras", "iera", "iéramos", "ierais", "ieran"], ["iera", "ieras", "iera", "iéramos", "ierais", "ieran"]),
                [("Si tuviera tiempo, viajaría más.", "If I had time, I would travel more."),
