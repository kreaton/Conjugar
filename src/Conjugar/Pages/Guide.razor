    // Blazor doesn't scroll to a #fragment when navigating, so do it on arrival and on in-page links.
    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await ScrollToFragment(Nav.Uri);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e) => await ScrollToFragment(e.Location);

    private async Task ScrollToFragment(string uri)
    {
        var fragment = new Uri(uri).Fragment.TrimStart('#');
        try
        {
            if (fragment.Length > 0) await JS.InvokeVoidAsync("conjugar.scrollToId", fragment);
        }
        catch (JSException) { }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
